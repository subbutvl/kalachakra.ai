{
  "name": "@kalachakra/api",
  "version": "0.1.0",
  "private": true,
  "description": "KalaChakra thin API (Hono on Node): validates input, calls the engine, returns JSON.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@hono/zod-openapi": "^1.6.3",
    "@kalachakra/engine": "workspace:*",
    "@kalachakra/report": "workspace:*",
    "@kalachakra/rules": "workspace:*",
    "@scalar/hono-api-reference": "0.12.16",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
