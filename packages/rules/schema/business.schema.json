{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$comment": {
      "type": "string"
    },
    "limits": {
      "type": "object",
      "properties": {
        "names": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "partners": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "names",
        "partners"
      ],
      "additionalProperties": false
    },
    "legal_suffixes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "popular_numbers": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9
      }
    },
    "popular_bonus": {
      "type": "number"
    },
    "trade_map": {
      "type": "object",
      "properties": {
        "$comment": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        }
      }
    },
    "trade_bonus": {
      "type": "number"
    },
    "domain_extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(\\.[a-z]+)+$"
      }
    },
    "ranking": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "total_score",
          "fewer_opposed_pairs",
          "input_order"
        ]
      }
    }
  },
  "required": [
    "limits",
    "legal_suffixes",
    "popular_numbers",
    "popular_bonus",
    "trade_map",
    "trade_bonus",
    "domain_extensions",
    "ranking"
  ],
  "additionalProperties": false
}
