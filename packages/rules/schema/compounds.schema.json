{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$comment": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "max_compound": {
      "type": "integer",
      "minimum": 10,
      "maximum": 9007199254740991
    },
    "compounds": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[1-9][0-9]$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "enum": [
                  "favourable",
                  "mixed",
                  "unfavourable"
                ]
              }
            },
            "required": [
              "name",
              "class"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "read_like": {
                "type": "integer",
                "minimum": 10,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "read_like"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "status",
    "max_compound",
    "compounds"
  ],
  "additionalProperties": false
}
