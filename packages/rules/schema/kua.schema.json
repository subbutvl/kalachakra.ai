{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$comment": {
      "type": "string"
    },
    "formula": {
      "type": "object",
      "properties": {
        "male": {
          "type": "object",
          "properties": {
            "base": {
              "type": "number",
              "const": 11
            },
            "op": {
              "type": "string",
              "const": "minus_s"
            }
          },
          "required": [
            "base",
            "op"
          ],
          "additionalProperties": false
        },
        "female": {
          "type": "object",
          "properties": {
            "base": {
              "type": "number",
              "const": 4
            },
            "op": {
              "type": "string",
              "const": "plus_s"
            }
          },
          "required": [
            "base",
            "op"
          ],
          "additionalProperties": false
        },
        "kua5": {
          "type": "object",
          "properties": {
            "male": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            },
            "female": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            }
          },
          "required": [
            "male",
            "female"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "male",
        "female",
        "kua5"
      ],
      "additionalProperties": false
    },
    "groups": {
      "type": "object",
      "properties": {
        "east": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          }
        },
        "west": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          }
        }
      },
      "required": [
        "east",
        "west"
      ],
      "additionalProperties": false
    },
    "direction_kinds": {
      "type": "object",
      "properties": {
        "good": {
          "minItems": 4,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "success",
              "health",
              "relationships",
              "growth",
              "mishaps",
              "five_ghosts",
              "six_killings",
              "total_loss"
            ]
          }
        },
        "avoid": {
          "minItems": 4,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "success",
              "health",
              "relationships",
              "growth",
              "mishaps",
              "five_ghosts",
              "six_killings",
              "total_loss"
            ]
          }
        }
      },
      "required": [
        "good",
        "avoid"
      ],
      "additionalProperties": false
    },
    "directions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[1-9]$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "success": {
            "type": "string",
            "enum": [
              "N",
              "NE",
              "E",
              "SE",
              "S",
              "SW",
              "W",
              "NW"
            ]
          },
          "health": {
            "type": "string",
            "enum": [
              "N",
              "NE",
              "E",
              "SE",
              "S",
              "SW",
              "W",
              "NW"
            ]
          },
          "relationships": {
            "type": "string",
            "enum": [
              "N",
              "NE",
              "E",
              "SE",
              "S",
              "SW",
              "W",
              "NW"
            ]
          },
          "growth": {
            "type": "string",
            "enum": [
              "N",
              "NE",
              "E",
              "SE",
              "S",
              "SW",
              "W",
              "NW"
            ]
          },
          "mishaps": {
            "type": "string",
            "enum": [
              "N",
              "NE",
              "E",
              "SE",
              "S",
              "SW",
              "W",
              "NW"
            ]
          },
          "five_ghosts": {
            "type": "string",
            "enum": [
              "N",
              "NE",
              "E",
              "SE",
              "S",
              "SW",
              "W",
              "NW"
            ]
          },
          "six_killings": {
            "type": "string",
            "enum": [
              "N",
              "NE",
              "E",
              "SE",
              "S",
              "SW",
              "W",
              "NW"
            ]
          },
          "total_loss": {
            "type": "string",
            "enum": [
              "N",
              "NE",
              "E",
              "SE",
              "S",
              "SW",
              "W",
              "NW"
            ]
          }
        },
        "required": [
          "success",
          "health",
          "relationships",
          "growth",
          "mishaps",
          "five_ghosts",
          "six_killings",
          "total_loss"
        ],
        "additionalProperties": false
      }
    },
    "fixed_cutoff": {
      "type": "object",
      "properties": {
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      },
      "required": [
        "month",
        "day"
      ],
      "additionalProperties": false
    },
    "lichun": {
      "type": "object",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "first_year": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "last_year": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "precision_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "utc": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^\\d{4}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^\\d{4}-02-0[2-6]T\\d{2}:\\d{2}Z$"
          }
        }
      },
      "required": [
        "first_year",
        "last_year",
        "precision_minutes",
        "utc"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formula",
    "groups",
    "direction_kinds",
    "directions",
    "fixed_cutoff",
    "lichun"
  ],
  "additionalProperties": false
}
