{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$comment": {
      "type": "string"
    },
    "decisions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^D([1-9]|1[0-9]|2[0-4])$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "settings": {
            "type": "object",
            "properties": {
              "names.analysed": {
                "type": "string",
                "enum": [
                  "both",
                  "birth_certificate",
                  "daily_use"
                ]
              },
              "date.day_boundary": {
                "type": "string",
                "enum": [
                  "civil_midnight",
                  "sunrise"
                ]
              },
              "masters.mode": {
                "type": "string",
                "enum": [
                  "always_reduce",
                  "pythagorean_and_personal_years",
                  "everywhere"
                ]
              },
              "letters.y_vowel": {
                "type": "string",
                "enum": [
                  "never",
                  "always",
                  "by_sound"
                ]
              },
              "bhagyank.sum_method": {
                "type": "string",
                "enum": [
                  "all_digits",
                  "components_first"
                ]
              },
              "planets.rahu_proxy": {
                "type": "string",
                "enum": [
                  "sun",
                  "moon",
                  "jupiter",
                  "mercury",
                  "venus",
                  "saturn",
                  "mars"
                ]
              },
              "planets.ketu_proxy": {
                "type": "string",
                "enum": [
                  "sun",
                  "moon",
                  "jupiter",
                  "mercury",
                  "venus",
                  "saturn",
                  "mars"
                ]
              },
              "planets.view_overrides": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "enum": [
                    "sun",
                    "moon",
                    "jupiter",
                    "rahu",
                    "mercury",
                    "venus",
                    "ketu",
                    "saturn",
                    "mars"
                  ]
                },
                "additionalProperties": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "enum": [
                      "sun",
                      "moon",
                      "jupiter",
                      "rahu",
                      "mercury",
                      "venus",
                      "ketu",
                      "saturn",
                      "mars"
                    ]
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "number",
                        "const": -1
                      },
                      {
                        "type": "number",
                        "const": 0
                      },
                      {
                        "type": "number",
                        "const": 1
                      }
                    ]
                  }
                }
              },
              "driver_conductor.special_pairs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[1-9]-[1-9]$"
                }
              },
              "compounds.classification": {
                "type": "string",
                "enum": [
                  "classical_draft",
                  "none"
                ]
              },
              "maturity.headline": {
                "type": "string",
                "enum": [
                  "pythagorean",
                  "chaldean"
                ]
              },
              "maturity.show_other": {
                "type": "boolean"
              },
              "loshu.include_mulank": {
                "type": "string",
                "enum": [
                  "always",
                  "two_digit_days_only",
                  "never"
                ]
              },
              "loshu.include_kua": {
                "type": "boolean"
              },
              "kua.year_cutoff": {
                "type": "string",
                "enum": [
                  "jan_1",
                  "fixed_feb_4",
                  "lichun"
                ]
              },
              "personal_year.start": {
                "type": "string",
                "enum": [
                  "jan_1",
                  "birthday"
                ]
              },
              "personal_year.show_birthday_year": {
                "type": "boolean"
              },
              "dasha.method": {
                "type": "string",
                "enum": [
                  "none",
                  "mulank_led"
                ]
              },
              "optimizer.max_edits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "optimizer.lock_first_letter": {
                "type": "boolean"
              },
              "mobile.zero_mode": {
                "type": "string",
                "enum": [
                  "ignore",
                  "pause",
                  "amplifier"
                ]
              },
              "vehicle.letters": {
                "type": "string",
                "enum": [
                  "digits_only",
                  "chaldean",
                  "both"
                ]
              },
              "compatibility.weights": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "default"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "driver_harmony": {
                        "type": "number",
                        "minimum": 0
                      },
                      "conductor_harmony": {
                        "type": "number",
                        "minimum": 0
                      },
                      "cross_harmony": {
                        "type": "number",
                        "minimum": 0
                      },
                      "loshu_gap_filling": {
                        "type": "number",
                        "minimum": 0
                      },
                      "life_path_synergy": {
                        "type": "number",
                        "minimum": 0
                      },
                      "name_harmony": {
                        "type": "number",
                        "minimum": 0
                      },
                      "kua_group": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "driver_harmony",
                      "conductor_harmony",
                      "cross_harmony",
                      "loshu_gap_filling",
                      "life_path_synergy",
                      "name_harmony",
                      "kua_group"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "remedies.enabled_tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "colour",
                    "direction",
                    "habit",
                    "mantra",
                    "fasting",
                    "gemstone",
                    "donation"
                  ]
                }
              },
              "mobile.reading_model": {
                "type": "string",
                "enum": [
                  "classic",
                  "element_flow",
                  "both"
                ]
              },
              "mobile.avoid_pairs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]{2}$"
                }
              },
              "business.legal_suffix": {
                "type": "string",
                "enum": [
                  "exclude",
                  "include"
                ]
              },
              "business.ampersand": {
                "type": "string",
                "enum": [
                  "ignore",
                  "as_and"
                ]
              },
              "business.digits": {
                "type": "string",
                "enum": [
                  "face_value"
                ]
              },
              "business.bonus": {
                "type": "string",
                "enum": [
                  "none",
                  "popular",
                  "by_trade"
                ]
              },
              "business.domain_count": {
                "type": "string",
                "enum": [
                  "with_extension",
                  "name_only"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "title",
          "settings"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "decisions"
  ],
  "additionalProperties": false
}
